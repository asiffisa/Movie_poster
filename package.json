{
  "name": "movie-poster",
  "version": "1.0.0",
  "description": "Find and insert high-quality TMDB movie and TV posters in Figma.",
  "main": "code.js",
  "scripts": {
    "setup": "node setup.js",
    "build": "tsc -p tsconfig.json && node setup.js",
    "lint": "eslint code.ts worker/src",
    "lint:fix": "eslint code.ts worker/src --fix",
    "watch": "tsc -p tsconfig.json --watch & node setup.js --watch",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:check": "tsc -p worker/tsconfig.json",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc --check"
  },
  "author": "Asif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asiffisa/Movie_poster.git"
  },
  "bugs": {
    "url": "https://github.com/asiffisa/Movie_poster/issues"
  },
  "homepage": "https://github.com/asiffisa/Movie_poster#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.132.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "typescript": "^5.3.2",
    "wrangler": "4.118.0"
  }
}
